{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wre.local/schemas/regression-result.schema.json",
  "title": "WRE Regression Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "runner",
    "status",
    "metrics",
    "checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "runner": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["pass", "fail", "error"]},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "comparator",
          "target",
          "observed",
          "abs_tolerance",
          "passed",
          "unit"
        ],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "comparator": {"type": "string", "enum": ["eq", "lte", "gte"]},
          "target": {"type": "number"},
          "observed": {"type": "number"},
          "abs_tolerance": {"type": "number", "minimum": 0},
          "passed": {"type": "boolean"},
          "unit": {"type": ["string", "null"]}
        }
      }
    }
  }
}
