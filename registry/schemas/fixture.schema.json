{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wre.local/schemas/fixture.schema.json",
  "title": "WRE Fixture Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "kind",
    "lane",
    "deterministic",
    "seed",
    "input_files",
    "expectations",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "kind": {"type": "string", "enum": ["synthetic", "captured", "derived"]},
    "lane": {"type": "string", "enum": ["fast", "regression", "full"]},
    "deterministic": {"type": "boolean"},
    "seed": {"type": ["integer", "null"]},
    "input_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "comparator", "target", "abs_tolerance", "unit"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "comparator": {"type": "string", "enum": ["eq", "lte", "gte"]},
          "target": {"type": "number"},
          "abs_tolerance": {"type": "number", "minimum": 0},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
